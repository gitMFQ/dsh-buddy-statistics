{
  "name": "dsh-buddy-statistics",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 统计插件：复刻 CodeBuddy Code 的统计页，汇总本机会话的 Token、模型与工具使用情况",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "statistics",
    "stats",
    "usage",
    "tokens",
    "统计",
    "用量"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitMFQ/dsh-buddy-statistics.git"
  },
  "homepage": "https://github.com/gitMFQ/dsh-buddy-statistics#readme",
  "bugs": {
    "url": "https://github.com/gitMFQ/dsh-buddy-statistics/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node test/fold-check.mjs && node test/client-smoke.mjs"
  }
}
